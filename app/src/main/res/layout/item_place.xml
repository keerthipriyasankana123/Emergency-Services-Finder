<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="#1E1E2C"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeColor="#333344"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Row: Name and Green Distance Badge -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvPlaceName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@id/tvDistance"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="City Hospital" />

            <TextView
                android:id="@+id/tvDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:background="@drawable/bg_distance_badge"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:textColor="#00E676"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="0.5 km" />

        </RelativeLayout>

        <!-- Address / Details -->
        <TextView
            android:id="@+id/tvPlaceAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#B0BEC5"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="123 Main St"
            tools:visibility="visible" />

        <!-- Actions Row: Favourite | Directions | Call -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Favourite Action -->
            <LinearLayout
                android:id="@+id/btnFavorite"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="start|center_vertical"
                android:orientation="horizontal"
                android:padding="4dp">

                <ImageView
                    android:id="@+id/ivFavoriteIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Favorite"
                    android:src="@drawable/ic_favorite_border"
                    app:tint="#E0E0E0" />

                <TextView
                    android:id="@+id/tvFavoriteText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Favourite"
                    android:textColor="#E0E0E0"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Directions Action -->
            <LinearLayout
                android:id="@+id/btnDirections"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="4dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Directions"
                    android:src="@drawable/ic_directions"
                    app:tint="#64B5F6" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Directions"
                    android:textColor="#64B5F6"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Call Action -->
            <LinearLayout
                android:id="@+id/btnCall"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="end|center_vertical"
                android:orientation="horizontal"
                android:padding="4dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Call"
                    android:src="@drawable/ic_call"
                    app:tint="#81C784" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Call"
                    android:textColor="#81C784"
                    android:textSize="14sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
